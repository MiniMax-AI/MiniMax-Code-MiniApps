{
  "name": "minimax-pet-source",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "桌宠插件的开发与验证工具，不进入分发包。",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test dev/*.test.mjs",
    "test:smoke": "node dev/smoke-api.mjs",
    "dev": "node dev/run-local.mjs",
    "package": "node scripts/package.mjs",
    "check:package": "node scripts/check-package.mjs",
    "build:markdown": "node tools/build-markdown.mjs",
    "generate:art": "node scripts/generate-pet-art.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "jsdom": "24.1.3",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  }
}
