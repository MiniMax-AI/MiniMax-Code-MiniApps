# Python bytecode caches from running the mutation harnesses.
#
# tests/ has 25+ .py files and they run on every `node tests/run.mjs`, so CPython drops a
# __pycache__/ into the package directory every time. It is not tracked and must never be: it is
# machine-specific, it changes shape between Python versions, and the plugin directory is the
# package that ships. The repository root .gitignore does not cover it.
__pycache__/
*.pyc

# tests/run.mjs hashes the shipped files before the mutation controls rewrite them, so a run killed
# mid-mutation is caught on the next one instead of being inferred from whatever the source looks
# like afterwards. The snapshot is machine-specific bookkeeping and this directory is the package
# that ships to readers, so it must never be tracked.
tests/.shipped-snapshot.json

# Derived artifacts. The runtime writes the search segments under its own data dir, which is
# outside this package; the runtime refuses a data dir that lands in here (see `start()` in
# miniapp/node/server.mjs). This entry is the second half of that rule: if a caller ever got
# through, the directory must not be tracked and must not be part of what ships.
trajectory-artifacts/