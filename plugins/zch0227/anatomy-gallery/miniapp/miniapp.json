{
  "schemaVersion": 1,
  "artifacts": {
    "client": ["./miniapp/client"],
    "node": ["./miniapp/node"]
  },
  "runtime": {
    "kind": "process",
    "entry": "./miniapp/node/server.mjs",
    "lifecycle": "on-demand"
  },
  "surface": {
    "path": "/gallery",
    "window": {
      "width": 1240,
      "height": 820,
      "minWidth": 720,
      "minHeight": 520
    }
  },
  "mcpEndpoints": [
    {
      "server": "anatomy-gallery",
      "path": "/mcp/anatomy-gallery"
    }
  ],
  "agentAccess": ["session.run"],
  "agentConcurrency": 4
}
