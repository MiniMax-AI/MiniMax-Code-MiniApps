{
  "schemaVersion": 1,
  "artifacts": {
    "client": ["./miniapp/client"],
    "node": ["./miniapp/node"]
  },
  "runtime": {
    "kind": "process",
    "entry": "./miniapp/node/server.mjs",
    "lifecycle": "on-demand"
  },
  "surface": {
    "path": "/bot",
    "window": {
      "width": 1180,
      "height": 780,
      "minWidth": 720,
      "minHeight": 480
    }
  },
  "mcpEndpoints": [{ "server": "minimax-bot-team", "path": "/mcp/minimax-bot-team" }],
  "agentAccess": ["session.run"]
}
