{
  "schemaVersion": 1,
  "artifacts": {
    "client": [
      "./miniapp/client"
    ],
    "node": [
      "./miniapp/node"
    ]
  },
  "runtime": {
    "kind": "process",
    "entry": "./miniapp/node/server.mjs",
    "lifecycle": "on-demand"
  },
  "surface": {
    "path": "/viewer"
  },
  "mcpEndpoints": [
    {
      "server": "cq-viewer",
      "path": "/mcp/cq-viewer"
    }
  ],
  "agentAccess": [
    "session.run",
    "session.read"
  ],
  "agentConcurrency": 2
}
