{
  "schemaVersion": 1,
  "artifacts": {
    "client": [
      "./miniapp/client"
    ],
    "node": [
      "./miniapp/node"
    ]
  },
  "runtime": {
    "kind": "process",
    "entry": "./miniapp/node/server.mjs",
    "lifecycle": "on-demand"
  },
  "surface": {
    "path": "/editor",
    "window": {
      "width": 1280,
      "height": 820,
      "minWidth": 720,
      "minHeight": 480
    }
  },
  "mcpEndpoints": [
    {
      "server": "cutline",
      "path": "/mcp/cutline"
    }
  ]
}
