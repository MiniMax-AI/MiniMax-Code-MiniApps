+let resourceLoader: ((path: string) => Promise<string | null>) | undefined;
+export function registerProductAssetLoader(loader: typeof resourceLoader): void { resourceLoader = loader; }
+export async function ensureProductAssets(value: unknown): Promise<void> {
+  if (!resourceLoader) return;
+  const paths = new Set<string>();
+  function visit(item: unknown): void {
+    if (typeof item === 'string') {
+      if (item.startsWith('/') && !item.startsWith('//')) paths.add(item);
+      for (const family of item.split(',')) {
+        const font = findLocalFont(family.trim().replace(/^['"]|['"]$/g, ''));
