{
  "schemaVersion": 1,
  "artifacts": {
    "client": ["./miniapp/client"],
    "node": ["./miniapp/node"]
  },
  "runtime": {
    "kind": "process",
    "entry": "./miniapp/node/server.mjs",
    "lifecycle": "on-demand"
  },
  "surface": {
    "path": "/bridge",
    "window": {
      "width": 520,
      "height": 620,
      "minWidth": 380,
      "minHeight": 420
    }
  },
  "agentAccess": ["session.run"],
  "toolAccess": ["call"],
  "mcpEndpoints": []
}
