{
  "schemaVersion": 1,
  "artifacts": {
    "client": [
      "./miniapp/client"
    ],
    "node": [
      "./miniapp/node"
    ]
  },
  "runtime": {
    "kind": "process",
    "entry": "./miniapp/node/server.mjs",
    "lifecycle": "on-demand"
  },
  "surface": {
    "path": "/workbench"
  },
  "mcpEndpoints": [
    {
      "server": "factscribe",
      "path": "/mcp/factscribe"
    }
  ],
  "agentAccess": [
    "session.run"
  ]
}
