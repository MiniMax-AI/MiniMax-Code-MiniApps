{
  "schemaVersion": 1,
  "artifacts": {
    "client": ["./miniapp/client"],
    "node": ["./miniapp/node"]
  },
  "runtime": {
    "kind": "process",
    "entry": "./miniapp/node/server.mjs",
    "lifecycle": "on-demand"
  },
  "surface": {
    "path": "/workspace",
    "window": {
      "width": 1280,
      "height": 820,
      "minWidth": 420,
      "minHeight": 600,
      "resizable": true,
      "frame": true,
      "transparent": false,
      "alwaysOnTop": false,
      "skipTaskbar": false,
      "clickThrough": false
    }
  },
  "mcpEndpoints": [
    {
      "server": "openviking",
      "path": "/mcp/openviking"
    }
  ]
}
