{
  "schemaVersion": 1,
  "artifacts": {
    "client": [
      "./miniapp/client"
    ],
    "node": [
      "./miniapp/node"
    ]
  },
  "runtime": {
    "kind": "process",
    "entry": "./miniapp/node/server.mjs",
    "lifecycle": "on-demand"
  },
  "surface": {
    "path": "/board",
    "window": {
      "width": 1480,
      "height": 940,
      "minWidth": 1280,
      "minHeight": 720,
      "resizable": true,
      "frame": true
    }
  },
  "mcpEndpoints": []
}
